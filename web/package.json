{
  "name": "safeaifactory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync-docs": "npx tsx scripts/sync-docs.ts",
    "dev": "npx tsx scripts/sync-docs.ts && next dev",
    "build": "npx tsx scripts/sync-docs.ts && next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --exclude types",
    "mascot:sprites:build": "tsx public/mascot/frames/build.mts",
    "mascot:sprites:extract": "tsx public/mascot/frames/extract.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "framer-motion": "^12.35.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "next": "^15.0.0",
    "next-mdx-remote": "^6.0.0",
    "next-plausible": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "knip": "^5.88.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.2"
  }
